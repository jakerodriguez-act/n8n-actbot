{{#each vendors}}

  <div style="margin-bottom: 12px;">
    <span class="dot" style="background:#0D8061;margin-top:4px;flex-shrink:0"></span>
    <div>
      <div style="font-weight:700;font-size:13px;color:var(--navy);margin-bottom:3px">{{vendor}}</div>
      <p style="font-size:12px;color:#555;margin:0;line-height:1.5">{{update}}</p>
    </div>
  </div>

{{/each}}