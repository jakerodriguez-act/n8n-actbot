<div class="briefing-row" style="display:flex;gap:11px;padding:12px 0;border-bottom:1px solid var(--periwinkle);">
  <div class="dot" style="background:{{color}};margin-top:4px;flex-shrink:0;width:10px;height:10px;"></div>
  <div>
    <div class="briefing-vendor-name" style="display:flex;gap:7px;align-items:center;flex-wrap:wrap;">
        <p style="color:inherit;text-decoration:none;border-bottom:1px dashed var(--navy);margin-bottom:4px;">
          <strong style="font-size: 16px;color:var(--navy);">{{crm}}</strong> <span style="font-size:12px;color:#888; margin-left: 12px;">{{date}}</span>
        </p>
    </div>
    <div class="briefing-row-summary" style="font-size:12.5px;color:#444;line-height:1.5;margin:0 0 5px;">
      {{result.description}}
    </div>
    <div class="briefing-row-sources">
      <div><a style="font-size:11.5px;color:var(--blue);font-weight:600;" href="{{result.url}}" target="_blank">→ {{result.title}}</a></div>
    </div>
  </div>
</div>